; Funciones de obs.dll que usa zuena-link.dll. Con esto se genera la biblioteca de importación
; (lib /def) sin instalar OBS ni su código fuente.
LIBRARY obs
EXPORTS
    obs_register_source_s
    obs_source_output_audio
    obs_get_audio_info
    obs_data_get_int
    obs_data_set_default_int
    obs_properties_create
    obs_properties_add_list
    obs_property_list_add_int
    obs_properties_add_text
    obs_property_set_long_description
    os_gettime_ns
    blog
